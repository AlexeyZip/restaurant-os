{
  "compileOnSave": false,
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "strict": true,
    "paths": {
      "@restaurant-os/database": ["./libs/backend/database/src/index.ts"],
      "@restaurant-os/generated/prisma": ["generated/prisma/client.ts"],
      "@restaurant-os/auth": ["./libs/backend/auth/src/index.ts"],
      "@restaurant-os/menu": ["./libs/backend/menu/src/index.ts"],
      "@restaurant-os/orders": ["./libs/backend/orders/src/index.ts"],
      "@restaurant-os/reservations": [
        "./libs/backend/reservations/src/index.ts"
      ],
      "@restaurant-os/kitchen": ["./libs/backend/kitchen/src/index.ts"],
      "@restaurant-os/ui": ["./libs/frontend/ui/src/index.ts"],
      "@restaurant-os/shared/util": ["./libs/shared/util/src/index.ts"],
      "@restaurant-os/auth-client": ["./libs/frontend/auth-client/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
