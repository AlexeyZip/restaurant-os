// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  status        UserStatus @default(ACTIVE)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  roles         UserRole[]
  refreshTokens RefreshToken[]
  orders        Order[]
  reservations  Reservation[]
}

model Role {
  id          String   @id @default(cuid())
  name        RoleName @unique
  createdAt   DateTime @default(now())

  users       UserRole[]
}

model UserRole {
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  user      User @relation(fields: [userId], references: [id])
  role      Role @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MenuCategory {
  id         String   @id @default(cuid())
  name       String   @unique
  order      Int
  available  Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  dishes    Dish[]
}

model Dish {
  id           String           @id @default(cuid())
  name         String
  description  String?
  /// Minor currency units (e.g. kopiykas), not whole UAH. See
  /// @restaurant-os/shared/util's formatMoney/RESTAURANT_CURRENCY.
  basicPrice   Int
  imageUrl     String?
  categoryId   String
  availability DishAvailability @default(AVAILABLE)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  category     MenuCategory     @relation(fields: [categoryId], references: [id])
  orderItems   OrderItem[]
}

model Order {
  id              String      @id @default(cuid())
  orderType       OrderType
  userId          String
  deliveryAddress String?
  tableNumber     Int?
  status          OrderStatus @default(CREATED)
  /// Minor currency units, same convention as Dish.basicPrice.
  totalPrice       Int
  notes           String?
  cancelReason    String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user            User        @relation(fields: [userId], references: [id])
  items           OrderItem[]
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  dishId    String
  dishName  String   // snapshot
  unitPrice Int      // snapshot, minor currency units
  quantity  Int

  order     Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  dish      Dish  @relation(fields: [dishId], references: [id])
}

model Table {
  id        String   @id @default(cuid())
  number    Int      @unique
  capacity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  active    Boolean  @default(true)

  reservations Reservation[]
}

model Reservation {
  id           String            @id @default(cuid())
  tableId      String
  userId       String
  guestCount   Int
  startsAt     DateTime
  endsAt       DateTime
  status       ReservationStatus @default(PENDING)
  notes        String?
  cancelReason String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  table        Table @relation(fields: [tableId], references: [id])
  user         User  @relation(fields: [userId], references: [id])
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BANNED
}

enum RoleName {
  CLIENT
  STAFF
  KITCHEN
  ADMIN
}

enum DishAvailability{
  AVAILABLE
  UNAVAILABLE
  HIDDEN
}

enum OrderType {
  DINE_IN
  DELIVERY
  TAKEAWAY
}

enum OrderStatus {
  CREATED
  CONFIRMED
  IN_PROGRESS
  READY
  OUT_FOR_DELIVERY
  COMPLETED
  CANCELLED
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  SEATED
  COMPLETED
  NO_SHOW
  CANCELLED
}
